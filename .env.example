# ─── Base de datos (Neon Serverless Postgres) ──────────────────────────
# Obtén ambos valores desde tu proyecto en console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/focalize?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/focalize?sslmode=require"

# ─── Auth.js ───────────────────────────────────────────────────────────
# Genera un secreto aleatorio: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# ─── Resend (email) ────────────────────────────────────────────────────
# Obtén tu API key en resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
# El email verificado en Resend desde el cual envías
RESEND_FROM_EMAIL="Focalize <noreply@tudominio.com>"
# Tu email personal donde recibirás las notificaciones nocturnas
NOTIFICATION_EMAIL="tu@correo.com"

# ─── WhatsApp (CallMeBot) ──────────────────────────────────────────────
# Sigue las instrucciones en callmebot.com/blog/free-whatsapp-messages-callmebot/
# El API key se obtiene enviando un WhatsApp a +34 644 44 44 51 con el texto:
# "I allow callmebot to send me messages"
CALLMEBOT_API_KEY="123456"

# ─── Vercel Cron (protección del endpoint) ────────────────────────────
# Genera un secreto aleatorio: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"
